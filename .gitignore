# Rust build output, anywhere in the workspace
target/
**/*.rs.bk
*.pdb

# Tauri generated schemas and capabilities
/src-tauri/gen/

# Staged Windows libheif runtime (scripts/bundle-heif-dlls.ps1, D-070)
/src-tauri/heif-runtime/*.dll
/src-tauri/heif-runtime/NOTICE-*.txt
/src-tauri/heif-runtime/bundled-dlls.txt

# Node
node_modules/
dist/
*.tsbuildinfo
.pnpm-store/

# Secrets and machine-local env
.env
.env.*
!.env.example

# Editors, local agent state, OS
.vscode/*
!.vscode/extensions.json
.idea/
.claude/
.DS_Store
Thumbs.db
Desktop.ini

# Xcode / iOS local build products (D-082)
ios/**/xcuserdata/
ios/**/DerivedData/
ios/*.xcworkspace/xcuserdata/
*.xcuserstate

# Android local build products (D-083)
android/.gradle/
android/**/build/
android/local.properties
android/app/src/main/jniLibs/**/*.so
android/**/.cxx/

# Logs and test coverage
*.log
coverage/
