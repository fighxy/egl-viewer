{
  "sourceLanguage": "en",
  "strings": {
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID opens egl-viewer when you have turned on the app lock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID открывает egl-viewer, если включена защита приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启应用锁后，可使用面容 ID 打开 egl-viewer。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "egl-viewer saves the images you share to Photos only when you choose Save Image."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "egl-viewer сохраняет изображения в «Фото» только когда вы выбираете «Сохранить изображение»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当你选择“存储图像”时，egl-viewer 才会将分享的图像存入“照片”。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
