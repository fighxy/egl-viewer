    "eagle.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders, tags, ratings, notes, links and smart folders come along. Folder passwords do not: locked folders come in locked without a password, and you set a new one in the library."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переносятся папки, теги, оценки, заметки, ссылки и умные папки. Пароли папок не переносятся: запертые папки приходят запертыми без пароля, новый пароль задаётся уже в библиотеке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹、标签、评分、注释、链接和智能文件夹都会导入。文件夹密码不会导入：加锁的文件夹导入后仍为加锁状态但没有密码，可在资源库中设置新密码。"
          }
        }
      }
    },
