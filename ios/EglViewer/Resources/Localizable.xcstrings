    "appLock.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app asks for it at launch and whenever it comes back. Folders you opened lock again when the app leaves the screen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение спрашивает его при запуске и при каждом возвращении. Открытые папки снова закрываются, когда приложение уходит с экрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时以及每次返回时都会要求输入。应用离开屏幕时，已打开的文件夹会重新锁定。"
          }
        }
      }
    },
