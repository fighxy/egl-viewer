{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "egl-viewer",
  "version": "0.2.1",
  "identifier": "com.fighxy.eglviewer",
  "build": {
    "beforeDevCommand": "pnpm --filter egl-viewer-ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter egl-viewer-ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "egl-viewer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: thumb: http://thumb.localhost; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: thumb: http://thumb.localhost; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173; font-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1MEQyRDEzMUMzQzQxMjEKUldRaFFUd2NFeTBOMVNrK2hIa2cyRmtZWWFrbHd2SkFtb2FQL0J4UnpZYzZ0QUFJMjl0YmVYaHQK",
      "endpoints": [
        "https://github.com/fighxy/egl-viewer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
